<!-- Development only. ClickHouse records its own metrics every second, samples every query with a
     profiler and keeps its text log in a table; merging those tables kept an idle server at one to
     two cores on a laptop. query_log and part_log stay for debugging queries and inserts. -->
<clickhouse>
    <asynchronous_metric_log remove="1" />
    <metric_log remove="1" />
    <query_metric_log remove="1" />
    <latency_log remove="1" />
    <trace_log remove="1" />
    <text_log remove="1" />
    <processors_profile_log remove="1" />
    <error_log remove="1" />
</clickhouse>
