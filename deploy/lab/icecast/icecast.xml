<icecast>
    <location>Caligo lab</location>
    <admin>lab@localhost</admin>
    <hostname>icecast</hostname>

    <limits>
        <clients>2000</clients>
        <sources>4</sources>
        <queue-size>524288</queue-size>
        <client-timeout>30</client-timeout>
        <header-timeout>15</header-timeout>
        <source-timeout>10</source-timeout>
        <burst-on-connect>1</burst-on-connect>
        <burst-size>65535</burst-size>
    </limits>

    <authentication>
        <source-password>@PASSWORD@</source-password>
        <relay-password>@PASSWORD@</relay-password>
        <admin-user>admin</admin-user>
        <admin-password>@PASSWORD@</admin-password>
    </authentication>

    <listen-socket>
        <port>8000</port>
    </listen-socket>

    <mount type="normal">
        <mount-name>/stream</mount-name>
        <max-listeners>2000</max-listeners>
        <public>0</public>
    </mount>

    <fileserve>0</fileserve>

    <paths>
        <basedir>/usr/share/icecast2</basedir>
        <logdir>/dev</logdir>
        <webroot>/usr/share/icecast2/web</webroot>
        <adminroot>/usr/share/icecast2/admin</adminroot>
        <pidfile>/tmp/icecast.pid</pidfile>
    </paths>

    <logging>
        <accesslog>null</accesslog>
        <errorlog>stderr</errorlog>
        <loglevel>2</loglevel>
    </logging>

    <security>
        <chroot>0</chroot>
    </security>
</icecast>
