<Project Sdk="Microsoft.NET.Sdk.Web">

	<PropertyGroup>
		<TargetFramework>net8.0</TargetFramework>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
	</PropertyGroup>

	<!--
		The web host references Infrastructure only to call AddPostsInfrastructure at startup;
		everything it uses day to day comes from Application. Domain is reached transitively and
		is never referenced directly by a controller.
	-->
	<ItemGroup>
		<ProjectReference Include="../Blog.Posts.Infrastructure/Blog.Posts.Infrastructure.csproj" />
		<ProjectReference Include="../../shared/Blog.Observability/Blog.Observability.csproj" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="AspNetCore.HealthChecks.Npgsql" />
		<PackageReference Include="AspNetCore.HealthChecks.Redis" />
		<PackageReference Include="Google.Apis.Auth" />
		<PackageReference Include="OpenTelemetry.Instrumentation.EntityFrameworkCore" />
		<PackageReference Include="OpenTelemetry.Instrumentation.StackExchangeRedis" />
		<PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" />
		<PackageReference Include="Microsoft.EntityFrameworkCore.Tools">
			<PrivateAssets>all</PrivateAssets>
			<IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
		</PackageReference>
		<PackageReference Include="Microsoft.Extensions.Caching.StackExchangeRedis" />
		<PackageReference Include="Swashbuckle.AspNetCore" />
	</ItemGroup>

</Project>
