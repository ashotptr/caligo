{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "_comment_Notifications": "This service's own PostgreSQL database. Required.",
    "Notifications": ""
  },
  "Notifications": {
    "_comment_RabbitMq": "amqp://user:pass@host:5672/. Empty disables outbound email.",
    "RabbitMq": "",
    "_comment_KafkaBootstrapServers": "host:9092. Empty stops the lifecycle relay.",
    "KafkaBootstrapServers": "",
    "RelayGroup": "notifications-relay",
    "Prefetch": 10,
    "SiteUrl": "http://localhost:8080",
    "SweepInterval": "00:01:00",
    "StrandedAfter": "00:02:00"
  },
  "Smtp": {
    "_comment_Host": "SMTP host. Empty makes every send fail, which is visible in the dead-letter queue.",
    "Host": "",
    "Port": 1025,
    "UseStartTls": false,
    "FromAddress": "blog@localhost",
    "FromName": "Blog"
  }
}
