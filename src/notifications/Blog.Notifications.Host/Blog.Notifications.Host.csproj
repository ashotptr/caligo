<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <!--
    References Blog.Contracts but not Blog.Contracts.Grpc: this service consumes JSON events
    and speaks no gRPC, so it has no reason to carry Protobuf. That separation is why the
    generated contract lives in its own project.
  -->
  <ItemGroup>
    <ProjectReference Include="../Blog.Notifications.Core/Blog.Notifications.Core.csproj" />
    <ProjectReference Include="../../shared/Blog.Contracts/Blog.Contracts.csproj" />
    <ProjectReference Include="../../shared/Blog.Observability/Blog.Observability.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="AspNetCore.HealthChecks.Npgsql" />
    <PackageReference Include="Confluent.Kafka" />
    <PackageReference Include="MailKit" />
    <PackageReference Include="MimeKit" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />
    <PackageReference Include="OpenTelemetry.Instrumentation.EntityFrameworkCore" />
    <PackageReference Include="RabbitMQ.Client" />
  </ItemGroup>

</Project>
