    "prisma": "^7.10.1",
    "puppeteer-core": "^25.16.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.5",
    "typescript": "~6.0.2",
    "vitest": "^5.1.0"
  }
}
