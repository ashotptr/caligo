{
  "name": "caligo-share",
  "private": true,
  "version": "0.0.0",
  "description": "Link previews: Open Graph pages for link crawlers and share card images.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "prisma generate && tsc",
